#!/usr/bin/env bash

set -u

JAMSESSION_VERSION="0.1.0-dev"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -z "${JAMSESSION_HOME:-}" ]; then
  if [ -d "$SCRIPT_DIR/adapters" ]; then
    JAMSESSION_HOME="$SCRIPT_DIR"
  elif [ -d "$SCRIPT_DIR/../adapters" ]; then
    JAMSESSION_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"
  else
    JAMSESSION_HOME="$HOME/.agents/jamsession"
  fi
fi

JAMSESSION_ADAPTER_DIR="${JAMSESSION_ADAPTER_DIR:-$JAMSESSION_HOME/adapters}"
JAMSESSION_CONFIG="${JAMSESSION_CONFIG:-$JAMSESSION_HOME/jamsession.conf}"
JAMSESSION_SKILL_DIR="${JAMSESSION_SKILL_DIR:-$HOME/.agents/skills}"
export JAMSESSION_HOME JAMSESSION_ADAPTER_DIR JAMSESSION_CONFIG JAMSESSION_SKILL_DIR

if [ -f "$JAMSESSION_CONFIG" ]; then
  # The config is intentionally a user-owned shell file.
  # shellcheck source=/dev/null
  source "$JAMSESSION_CONFIG"
fi
export JAMSESSION_CODEX_BIN JAMSESSION_CLAUDE_BIN JAMSESSION_CURSOR_BIN \
  JAMSESSION_GROK_BIN JAMSESSION_COPILOT_BIN

usage() {
  cat <<'EOF'
jamsession — one small interface for coding-agent CLIs

Usage:
  jamsession run <provider> <new|session> <model> <effort> <read|edit> <prompt>
  jamsession list <provider> [count]
  jamsession models <provider>
  jamsession usage [provider] [--json]
  jamsession status [provider]
  jamsession doctor [provider]
  jamsession providers
  jamsession init
  jamsession make-adapter <provider> [--force]
  jamsession skills [list|install <name|all>|uninstall <name|all>]
  jamsession update
  jamsession uninstall
  jamsession help [command|provider]

The prompt may be `-` to read stdin. Provider output goes to stdout; session
IDs, hints, warnings, and diagnostics go to stderr.

`providers` lists the installed provider adapters. `adapters` is an exact alias.
EOF
}

# Temporary files live in a private mktemp directory rather than a predictable
# path, so a hostile file in a shared /tmp cannot be targeted or substituted.
JAMSESSION_TEMP_DIR=""

clean_temp_dir() {
  [ -n "$JAMSESSION_TEMP_DIR" ] || return 0
  rm -rf "$JAMSESSION_TEMP_DIR"
  JAMSESSION_TEMP_DIR=""
}

make_temp_dir() {
  clean_temp_dir
  JAMSESSION_TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/jamsession.XXXXXX")" || \
    die "could not create a private temporary directory"
  trap 'clean_temp_dir' EXIT
  trap 'clean_temp_dir; exit 130' HUP INT TERM
}

bundled_skills() {
  printf '%s\n' \
    jamsession-summon-agent \
    jamsession-get-agent-usage \
    jamsession-model-recommendations \
    jamsession-ping-pong-planning \
    jamsession-contrarian-review \
    jamsession-ask-agent-panel \
    jamsession-orchestrate-agent-work \
    jamsession-individual-worker-workflow \
    jamsession-work-over-ssh \
    jamsession-use-remote-agent-over-ssh
}

known_skill() {
  local wanted="$1" skill
  while IFS= read -r skill; do
    [ "$skill" = "$wanted" ] && return 0
  done < <(bundled_skills)
  return 1
}

list_skills() {
  local skill state
  while IFS= read -r skill; do
    state="available"
    [ -f "$JAMSESSION_SKILL_DIR/$skill/SKILL.md" ] && state="installed"
    printf '%-36s %s\n' "$skill" "$state"
  done < <(bundled_skills)
}

install_one_skill() {
  local skill="$1" target temp metadata source_root
  known_skill "$skill" || die "unknown bundled skill '$skill'"
  command -v curl >/dev/null 2>&1 || die "installing skills requires curl"
  target="$JAMSESSION_SKILL_DIR/$skill"
  source_root="${JAMSESSION_SOURCE_URL:-https://raw.githubusercontent.com/jamonholmgren/jamsession/main}"
  make_temp_dir
  temp="$JAMSESSION_TEMP_DIR/SKILL.md"
  metadata="$JAMSESSION_TEMP_DIR/openai.yaml"
  curl -fsSL "$source_root/skills/$skill/SKILL.md" -o "$temp" || \
    die "could not download skill '$skill'"
  curl -fsSL "$source_root/skills/$skill/agents/openai.yaml" -o "$metadata" || \
    die "could not download metadata for skill '$skill'"
  [ -s "$temp" ] || die "downloaded skill '$skill' is empty"
  [ -s "$metadata" ] || die "downloaded metadata for skill '$skill' is empty"
  chmod 644 "$temp" "$metadata"
  mkdir -p "$target/agents"
  mv "$temp" "$target/SKILL.md"
  mv "$metadata" "$target/agents/openai.yaml"
  clean_temp_dir
  printf 'Installed %s\n' "$target/SKILL.md"
}

# The `jamsession-` prefix is the ownership rule for removal. Jam Session owns
# that namespace under the skill directory, so a prefixed directory is removable
# whether it is bundled or one you wrote yourself. Anything else is untouchable.
valid_skill_name() {
  local suffix
  case "$1" in
    jamsession-*) suffix="${1#jamsession-}" ;;
    *) return 1 ;;
  esac
  case "$suffix" in
    ""|*[!a-zA-Z0-9_-]*) return 1 ;;
    *) return 0 ;;
  esac
}

JAMSESSION_SKILL_ROOT=""

# Sets JAMSESSION_SKILL_ROOT to the resolved skill directory. Returns 1 when it
# does not exist, and dies when it exists but is not safe to remove from.
require_skill_root() {
  local marker parent
  JAMSESSION_SKILL_ROOT=""
  case "$JAMSESSION_SKILL_DIR" in
    /*) ;;
    *) die "JAMSESSION_SKILL_DIR must be an absolute path: $JAMSESSION_SKILL_DIR" ;;
  esac
  [ -d "$JAMSESSION_SKILL_DIR" ] || return 1
  JAMSESSION_SKILL_ROOT="$(resolve_removable_dir "the skill directory" "$JAMSESSION_SKILL_DIR")" || exit $?
  parent="${JAMSESSION_SKILL_ROOT%/*}"
  for marker in .git install.sh tests; do
    [ ! -e "$parent/$marker" ] || die \
      "refusing to remove skills in $JAMSESSION_SKILL_ROOT: its parent contains $marker and looks like a source checkout"
  done
  return 0
}

# Immediate children of the skill root that carry the reserved prefix.
installed_skill_dirs() {
  local path name
  for path in "$JAMSESSION_SKILL_ROOT"/*; do
    [ -d "$path" ] || continue
    name="${path##*/}"
    valid_skill_name "$name" || continue
    printf '%s\n' "$name"
  done
}

# Removes one explicitly targeted skill directory whole. A prefixed directory is
# Jam Session's, so files you added inside it go with it; that is announced
# rather than silently skipped, because leaving the skill half-removed would be
# worse than saying what went. Returns 0 removed, 1 absent, 2 refused.
remove_skill_dir() {
  local skill="$1" dir entry extra=0
  dir="$JAMSESSION_SKILL_ROOT/$skill"
  if [ -L "$dir" ]; then
    printf 'jamsession: left %s; it is a symlink, not a skill directory\n' "$dir" >&2
    return 2
  fi
  [ -d "$dir" ] || return 1
  for entry in "$dir"/* "$dir"/.*; do
    [ -e "$entry" ] || continue
    case "${entry##*/}" in
      .|..|SKILL.md) continue ;;
    esac
    extra=1
    break
  done
  rm -rf "$dir"
  if [ "$extra" -eq 1 ]; then
    printf 'Removed %s (including files Jam Session did not install)\n' "$dir"
  else
    printf 'Removed %s\n' "$dir"
  fi
  return 0
}

uninstall_one_skill() {
  local skill="$1" outcome=0
  valid_skill_name "$skill" || \
    die "invalid skill name '$skill'; jamsession only removes skills named jamsession-*"
  require_skill_root || fail "no skill directory at $JAMSESSION_SKILL_DIR"
  remove_skill_dir "$skill" || outcome=$?
  case "$outcome" in
    0) ;;
    1) fail "skill '$skill' is not installed in $JAMSESSION_SKILL_ROOT" ;;
    *) exit 1 ;;
  esac
}

uninstall_all_skills() {
  local skill removed=0 left=0
  if ! require_skill_root; then
    printf 'jamsession: no skill directory at %s\n' "$JAMSESSION_SKILL_DIR" >&2
    return 0
  fi
  while IFS= read -r skill; do
    if remove_skill_dir "$skill"; then
      removed=$((removed + 1))
    else
      left=1
    fi
  done < <(installed_skill_dirs)
  [ "$removed" -ne 0 ] || printf 'No jamsession-* skills were installed in %s\n' "$JAMSESSION_SKILL_ROOT"
  [ "$left" -eq 0 ] || exit 1
}

skills_command() {
  local action="${1:-list}" requested skill
  case "$action" in
    list)
      [ $# -le 1 ] || die "skills list takes no other arguments"
      list_skills
      ;;
    install)
      [ $# -eq 2 ] || die "skills install needs <name|all>"
      requested="$2"
      if [ "$requested" = all ]; then
        while IFS= read -r skill; do install_one_skill "$skill"; done < <(bundled_skills)
      else
        install_one_skill "$requested"
      fi
      ;;
    uninstall)
      [ $# -eq 2 ] || die "skills uninstall needs <name|all>"
      requested="$2"
      if [ "$requested" = all ]; then
        uninstall_all_skills
      else
        uninstall_one_skill "$requested"
      fi
      ;;
    *) die "unknown skills command '$action'" ;;
  esac
}

# Uninstall removes only what the installer created, at exact paths it validates
# first. Anything it cannot prove it owns is left in place and reported, so an
# ambiguous layout never turns into a broad deletion.
resolved_dir() {
  ( cd "$1" 2>/dev/null && pwd -P )
}

# Rejects paths that are not a real directory, or that are roots no Jam Session
# artifact ever occupies.
resolve_removable_dir() {
  local label="$1" path="$2" resolved home_resolved
  case "$path" in
    /*) ;;
    *) die "$label must be an absolute path: $path" ;;
  esac
  resolved="$(resolved_dir "$path")"
  [ -n "$resolved" ] || return 1
  home_resolved="$(resolved_dir "$HOME")"
  case "$resolved" in
    /|/usr|/etc|/var|/opt|/home|/Users) die "refusing to touch $label at $resolved" ;;
  esac
  if [ -n "$home_resolved" ]; then
    case "$resolved" in
      "$home_resolved"|"$home_resolved"/.agents|"$home_resolved"/.local|"$home_resolved"/.local/bin)
        die "refusing to touch $label at $resolved" ;;
    esac
  fi
  printf '%s\n' "$resolved"
}

# A checkout and an installation can both be named jamsession, so the marker
# files decide. Only the installer produces bin/jamsession without them.
require_install_tree() {
  local root="$1" marker
  [ "${root##*/}" = jamsession ] || \
    die "refusing to remove an installation tree not named 'jamsession': $root"
  for marker in .git install.sh tests index.html README.md; do
    [ ! -e "$root/$marker" ] || die \
      "refusing to remove $root: it contains $marker, so it is a source checkout, not an installation. Run the installed command at ~/.local/bin/jamsession, or set JAMSESSION_HOME to the installation tree."
  done
  [ -f "$root/bin/jamsession" ] || \
    die "refusing to remove $root: it has no bin/jamsession, so it is not a Jam Session installation"
}

uninstall_command() {
  [ $# -eq 0 ] || die "uninstall takes no arguments"
  local root="" bin="" link skill left=0

  # Checked before existence: a relative override is a mistake worth reporting,
  # not a directory that happens to be missing.
  case "$JAMSESSION_HOME" in
    /*) ;;
    *) die "JAMSESSION_HOME must be an absolute path: $JAMSESSION_HOME" ;;
  esac
  case "$JAMSESSION_SKILL_DIR" in
    /*) ;;
    *) die "JAMSESSION_SKILL_DIR must be an absolute path: $JAMSESSION_SKILL_DIR" ;;
  esac

  # resolve_removable_dir runs in a subshell, so its refusal has to be
  # propagated deliberately rather than mistaken for a missing directory.
  if [ -d "$JAMSESSION_HOME" ]; then
    root="$(resolve_removable_dir "the installation tree" "$JAMSESSION_HOME")" || exit $?
    require_install_tree "$root"
    bin="$root/bin/jamsession"
  else
    printf 'jamsession: no installation tree at %s\n' "$JAMSESSION_HOME" >&2
  fi

  # Remove the link before the tree, while the target still exists to compare.
  link="$HOME/.local/bin/jamsession"
  if [ -L "$link" ]; then
    if [ -n "$bin" ] && [ "$link" -ef "$bin" ]; then
      rm -f "$link"
      printf 'Removed %s\n' "$link"
    else
      printf 'jamsession: left %s; it does not point at this installation\n' "$link" >&2
      left=1
    fi
  elif [ -e "$link" ]; then
    printf 'jamsession: left %s; it is not a symlink\n' "$link" >&2
    left=1
  fi

  # Skills are removed one validated directory at a time, by the same prefix rule
  # `skills uninstall all` uses. The skill root itself is never removed, and a
  # checkout's skills/ directory is refused outright.
  if require_skill_root; then
    while IFS= read -r skill; do
      remove_skill_dir "$skill" || left=1
    done < <(installed_skill_dirs)
  fi

  if [ -n "$root" ]; then
    rm -rf "$root"
    printf 'Removed %s\n' "$root"
  fi

  if [ "$left" -eq 1 ]; then
    printf 'jamsession: some paths were left in place; remove them yourself if you want them gone\n' >&2
    exit 1
  fi
  printf 'Jam Session is uninstalled.\n'
}

compact_usage() {
  cat >&2 <<'EOF'
Usage: jamsession run <provider> <new|session> <model> <effort> <read|edit> <prompt>
       jamsession <list|models> <provider> [arguments]
       jamsession <usage|status|doctor> [provider]
       jamsession <providers|init|make-adapter|skills|update|help>
       jamsession skills <list|install|uninstall> <name|all>
       jamsession uninstall
EOF
}

die() {
  printf 'jamsession: %s\n' "$*" >&2
  compact_usage
  exit 2
}

# A well-formed request that found nothing. The command contract was correct, so
# repeating it in a usage block would only bury the answer.
fail() {
  printf 'jamsession: %s\n' "$*" >&2
  exit 1
}

valid_provider() {
  case "$1" in
    ""|*[!a-zA-Z0-9_-]*) return 1 ;;
    *) return 0 ;;
  esac
}

adapter_path() {
  valid_provider "$1" || die "invalid provider '$1'"
  printf '%s/jamsession_%s\n' "$JAMSESSION_ADAPTER_DIR" "$1"
}

require_adapter() {
  local path
  path="$(adapter_path "$1")"
  [ -f "$path" ] || die "provider '$1' is not installed; run 'jamsession providers'"
  [ -x "$path" ] || die "adapter is not executable: $path"
  printf '%s\n' "$path"
}

list_adapters() {
  local path name
  [ -d "$JAMSESSION_ADAPTER_DIR" ] || return 0
  for path in "$JAMSESSION_ADAPTER_DIR"/jamsession_*; do
    [ -f "$path" ] && [ -x "$path" ] || continue
    name="${path##*/jamsession_}"
    printf '%s\n' "$name"
  done
  return 0
}

init_config() {
  local pair provider command variable resolved configured
  umask 077
  mkdir -p "$JAMSESSION_HOME" "$JAMSESSION_ADAPTER_DIR"
  if [ ! -f "$JAMSESSION_CONFIG" ]; then
    cat >"$JAMSESSION_CONFIG" <<'EOF'
# Jam Session configuration. This file is sourced as shell code.
# Keep it owned by you and do not make it writable by other users.

EOF
    printf 'Created %s\n' "$JAMSESSION_CONFIG"
  fi

  for pair in \
    'codex:codex:JAMSESSION_CODEX_BIN' \
    'claude:claude:JAMSESSION_CLAUDE_BIN' \
    'cursor:cursor-agent:JAMSESSION_CURSOR_BIN' \
    'grok:grok:JAMSESSION_GROK_BIN' \
    'copilot:copilot:JAMSESSION_COPILOT_BIN'; do
    provider="${pair%%:*}"
    command="${pair#*:}"; command="${command%%:*}"
    variable="${pair##*:}"
    eval "configured=\${$variable+x}"
    if [ "$configured" = x ]; then
      eval "resolved=\${$variable}"
      printf '%-8s configured: %s\n' "$provider" "$resolved"
    elif resolved="$(command -v "$command" 2>/dev/null)"; then
      printf '%s=%q\n' "$variable" "$resolved" >>"$JAMSESSION_CONFIG"
      printf '%-8s found: %s\n' "$provider" "$resolved"
    else
      printf '%-8s not found on PATH\n' "$provider"
    fi
  done

  cat <<'EOF'

Agent guidance:
jamsession normalizes non-interactive coding-agent CLIs so an agent can start or
resume explicit provider-native sessions. Run `jamsession help` for the command
contract, `jamsession status` for provider readiness and usage, and `jamsession help configure`
before changing configuration.
EOF
}

make_adapter() {
  [ $# -ge 1 ] && [ $# -le 2 ] || die "make-adapter needs <provider> [--force]"
  local provider="$1" force=0 target
  valid_provider "$provider" || die "invalid provider '$provider'"
  if [ $# -eq 2 ]; then
    [ "$2" = "--force" ] || die "unknown make-adapter argument '$2'"
    force=1
  fi
  mkdir -p "$JAMSESSION_ADAPTER_DIR"
  target="$JAMSESSION_ADAPTER_DIR/jamsession_$provider"
  [ ! -e "$target" ] || [ "$force" -eq 1 ] || die "$target already exists; add --force to replace it"
  cat >"$target" <<'EOF'
#!/usr/bin/env bash

set -u

PROVIDER="${0##*jamsession_}"

unsupported() {
  printf 'jamsession_%s: %s is not available for this provider\n' "$PROVIDER" "$1" >&2
  exit 3
}

die() {
  printf 'jamsession_%s: %s\n' "$PROVIDER" "$*" >&2
  exit 2
}

help_text() {
  cat <<HELP
jamsession_$PROVIDER adapter

Commands:
  jamsession_$PROVIDER run <new|session> <model> <effort> <read|edit> <prompt>
  jamsession_$PROVIDER list [count]
  jamsession_$PROVIDER models
  jamsession_$PROVIDER usage
  jamsession_$PROVIDER status
  jamsession_$PROVIDER doctor
  jamsession_$PROVIDER help

Implement each command using the provider CLI's native non-interactive and
resume features. A read run must hard-error unless writes are mechanically
blocked. Print agent output to stdout and metadata or warnings to stderr.
See the bundled adapters in ~/.agents/jamsession/adapters/ for small examples.
HELP
}

case "${1:-help}" in
  run)
    [ $# -eq 6 ] || die "run needs <new|session> <model> <effort> <read|edit> <prompt>"
    unsupported run
    ;;
  list|models|usage|status|doctor) unsupported "$1" ;;
  help|-h|--help) help_text ;;
  *) die "unknown command '$1'" ;;
esac
EOF
  chmod 755 "$target"
  printf 'Created %s\n' "$target"
  printf 'Edit it, then run: jamsession status %s\n' "$provider"
}

usage_helper() {
  if [ -x "$JAMSESSION_HOME/bin/jamsession_usage" ]; then
    printf '%s\n' "$JAMSESSION_HOME/bin/jamsession_usage"
  elif [ -x "$SCRIPT_DIR/jamsession_usage" ]; then
    printf '%s\n' "$SCRIPT_DIR/jamsession_usage"
  else
    printf '%s\n' "$SCRIPT_DIR/usage/jamsession_usage"
  fi
}

help_topic() {
  case "${1:-}" in
    "") usage ;;
    configure)
      cat <<EOF
Configuration: $JAMSESSION_CONFIG

jamsession sources this file as Bash. Run 'jamsession init' to add paths it can
discover without replacing existing values. Supported overrides:

  JAMSESSION_CODEX_BIN=/path/to/codex
  JAMSESSION_CLAUDE_BIN=/path/to/claude
  JAMSESSION_CURSOR_BIN=/path/to/cursor-agent
  JAMSESSION_GROK_BIN=/path/to/grok
  JAMSESSION_COPILOT_BIN=/path/to/copilot

Custom adapters belong in: $JAMSESSION_ADAPTER_DIR
EOF
      ;;
    make-adapter)
      cat <<'EOF'
Usage: jamsession make-adapter <provider> [--force]

Creates an executable adapter template in the configured adapter directory.
The command refuses to replace an existing file unless --force is explicit.
EOF
      ;;
    providers|adapters)
      cat <<'EOF'
Usage: jamsession providers

Lists the provider adapters installed in the adapter directory, one per line.
`jamsession adapters` is an exact alias for the same output.

An adapter appears here when it is a file named jamsession_<provider> and is
executable. Listing a provider does not mean its CLI is installed or
authenticated; run `jamsession status` for readiness and usage.
EOF
      ;;
    skills)
      cat <<EOF
Usage: jamsession skills [list]
       jamsession skills install <name|all>
       jamsession skills uninstall <name|all>

Skill directory: $JAMSESSION_SKILL_DIR

'list' shows every bundled skill and whether it is installed. 'install'
downloads bundled skills; 'all' means every bundled skill.

'uninstall <name>' removes one installed skill directory. The name must start
with 'jamsession-'; jamsession does not remove skills outside that namespace.
'uninstall all' removes every immediate directory under the skill directory
whose name starts with 'jamsession-', including prefixed skills you wrote
yourself. Unrelated skills and the skill directory itself are never touched.

Removal takes the whole directory. If you keep your own notes inside a
jamsession-* skill, they are removed with it and the command says so, because a
half-removed skill would be worse than a clear report.
EOF
      ;;
    uninstall)
      cat <<EOF
Usage: jamsession uninstall

Removes only what the installer created:

  $HOME/.local/bin/jamsession   the symlink, and only when it points at the
                                installation below
  $JAMSESSION_HOME              the whole installation tree, including
                                jamsession.conf and any custom adapters kept
                                inside it
  $JAMSESSION_SKILL_DIR/jamsession-*
                                every immediate skill directory whose name
                                starts with jamsession-, including prefixed
                                skills you wrote yourself, and any files you
                                kept inside them

It never removes the skill directory itself, a skill outside the jamsession-
namespace, a $HOME/.local/bin/jamsession that is not a symlink to this
installation, or a source checkout. Anything it cannot prove it owns is left in
place, named on stderr, and the command exits 1. Running it twice is safe.

Set JAMSESSION_HOME or JAMSESSION_SKILL_DIR to uninstall a non-default
location. Both must already exist and be exactly the paths you want removed.
EOF
      ;;
    run)
      cat <<'EOF'
Usage: jamsession run <provider> <new|session> <model> <effort> <read|edit> <prompt>

Use `new` to create a session or pass an exact provider-native session ID to
resume. Use `default` to let the provider choose its model or effort. `read`
must be enforced by the adapter; `edit` permits unattended workspace changes.
Pass `-` as the prompt to read stdin.
EOF
      ;;
    usage)
      cat <<'EOF'
Usage: jamsession usage [provider] [--json]

Shows subscription usage for every configured provider, or one provider. The
collector is Bash and system-tool based; it adds no language-runtime dependency.
Exit 0 means complete, 2 means partial, and 1 means no requested usage was read.
EOF
      ;;
    status)
      cat <<'EOF'
Usage: jamsession status [provider]

Shows provider authentication/readiness followed by available subscription
usage. Use this for the normal overview; use `doctor` when diagnosing a failed
provider and `usage --json` for scripts.
EOF
      ;;
    doctor)
      cat <<'EOF'
Usage: jamsession doctor [provider]

Runs provider authentication and installation diagnostics without collecting
subscription usage.
EOF
      ;;
    list|models)
      cat <<EOF
Usage: jamsession $1 <provider>

Runs the provider's native $1 operation.
EOF
      ;;
    *)
      local path
      path="$(require_adapter "$1")"
      exec "$path" help
      ;;
  esac
}

[ $# -gt 0 ] || { usage; exit 0; }

command_name="$1"
shift

case "$command_name" in
  run)
    [ $# -eq 6 ] || die "run needs <provider> <new|session> <model> <effort> <read|edit> <prompt>"
    provider="$1"; shift
    case "$4" in read|edit) ;; *) die "access must be read or edit" ;; esac
    exec "$(require_adapter "$provider")" run "$@"
    ;;
  list)
    [ $# -ge 1 ] && [ $# -le 2 ] || die "list needs <provider> [count]"
    provider="$1"; shift
    exec "$(require_adapter "$provider")" list "$@"
    ;;
  models)
    [ $# -eq 1 ] || die "$command_name needs <provider>"
    provider="$1"
    exec "$(require_adapter "$provider")" "$command_name"
    ;;
  usage)
    [ $# -le 2 ] || die "usage takes [provider] [--json]"
    exec "$(usage_helper)" "$@"
    ;;
  status)
    [ $# -le 1 ] || die "status takes at most one provider"
    status_provider="${1:-}"
    doctor_status=0
    if [ -n "$status_provider" ]; then
      "$(require_adapter "$status_provider")" doctor || doctor_status=$?
      printf '\nUsage:\n'
      "$(usage_helper)" "$status_provider" || true
    else
      "$0" doctor || doctor_status=$?
      printf '\nUsage:\n'
      "$(usage_helper)" || true
    fi
    # Status is the normal readiness check. Usage is useful context, but some
    # provider CLIs do not expose it to a non-interactive terminal. Do not turn
    # an otherwise ready provider into a failed preflight for that limitation.
    exit "$doctor_status"
    ;;
  doctor)
    [ $# -le 1 ] || die "doctor takes at most one provider"
    if [ $# -eq 1 ]; then
      exec "$(require_adapter "$1")" doctor
    fi
    failures=0
    while IFS= read -r provider; do
      [ -n "$provider" ] || continue
      printf '\n%s:\n' "$provider"
      "$(require_adapter "$provider")" doctor || failures=$((failures + 1))
    done < <(list_adapters)
    exit "$failures"
    ;;
  providers|adapters|agents)
    [ $# -eq 0 ] || die "$command_name takes no arguments"
    list_adapters
    ;;
  init)
    [ $# -eq 0 ] || die "init takes no arguments"
    init_config
    ;;
  make-adapter)
    make_adapter "$@"
    ;;
  skills)
    skills_command "$@"
    ;;
  update)
    [ $# -eq 0 ] || die "update takes no arguments"
    command -v curl >/dev/null 2>&1 || die "update requires curl"
    make_temp_dir
    update_file="$JAMSESSION_TEMP_DIR/install.sh"
    curl -fsSL "${JAMSESSION_INSTALL_URL:-https://raw.githubusercontent.com/jamonholmgren/jamsession/main/install.sh}" -o "$update_file" || exit $?
    [ -s "$update_file" ] || die "downloaded installer is empty"
    sh "$update_file"
    ;;
  uninstall)
    uninstall_command "$@"
    ;;
  help|-h|--help)
    [ $# -le 1 ] || die "help takes at most one topic"
    help_topic "${1:-}"
    ;;
  version|-v|--version)
    [ $# -eq 0 ] || die "version takes no arguments"
    printf 'jamsession %s\n' "$JAMSESSION_VERSION"
    ;;
  *) die "unknown command '$command_name'" ;;
esac
