#!/usr/bin/env bash

set -u

PROVIDERS="copilot codex claude cursor grok devin muse antigravity"
TIMEOUT="${JAMSESSION_USAGE_TIMEOUT:-20}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TEMP_DIR=""
CAPTURE_FILE=""
CAPTURE_PID=""
PROVIDER_WINDOWS=""
PROVIDER_ERROR_CODE="usage_unavailable"
PROVIDER_ERROR_MESSAGE="usage could not be read"

descendant_pids() {
  local pid="$1" depth="${2:-0}" child
  [ "$depth" -lt 8 ] || return 0
  printf '%s\n' "$pid"
  # pgrep needs sysmond, which can be down. ps still lists parents.
  for child in $(ps -axo pid=,ppid= | awk -v parent="$pid" '$2 == parent { print $1 }'); do
    descendant_pids "$child" $((depth + 1))
  done
}

stop_pid_tree() {
  local root="$1" signal pid pids
  [ -n "$root" ] || return 0
  pids="$(descendant_pids "$root" | awk 'NF { rows[++count] = $0 } END { for (i = count; i >= 1; i--) print rows[i] }')"
  for signal in TERM KILL; do
    printf '%s\n' "$pids" | while IFS= read -r pid; do
      [ -n "$pid" ] || continue
      kill "-$signal" "$pid" 2>/dev/null || true
    done
    [ "$signal" = TERM ] || break
    sleep 1
  done
}

cleanup() {
  if [ -n "$CAPTURE_PID" ]; then
    stop_pid_tree "$CAPTURE_PID"
    wait "$CAPTURE_PID" 2>/dev/null || true
    CAPTURE_PID=""
  fi
  [ -n "$TEMP_DIR" ] || return 0
  if [ -n "${JAMSESSION_USAGE_DEBUG_DIR:-}" ]; then
    mkdir -p "$JAMSESSION_USAGE_DEBUG_DIR"
    for debug_file in "$TEMP_DIR"/*.raw "$TEMP_DIR"/*.err; do
      [ -f "$debug_file" ] || continue
      cp "$debug_file" "$JAMSESSION_USAGE_DEBUG_DIR/"
    done
  fi
  rm -rf "$TEMP_DIR"
  TEMP_DIR=""
}

fail() {
  printf 'jamsession usage: %s\n' "$*" >&2
  exit 1
}

make_temp() {
  TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/jamsession-usage.XXXXXX")" || fail "could not create temporary directory"
  trap 'cleanup; exit 130' HUP INT TERM
}

json_escape() {
  local value="$1"
  value="$(printf '%s' "$value" | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177')"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '%s' "$value"
}

percent_left() {
  awk -v used="$1" 'BEGIN { left = 100 - used; if (left < 0) left = 0; printf "%g", left }'
}

format_epoch() {
  local epoch="$1"
  [ -n "$epoch" ] || { printf 'not exposed'; return; }
  if [ "$(uname -s)" = Darwin ]; then
    date -r "$epoch" '+%Y-%m-%d %H:%M %Z' 2>/dev/null || printf '%s' "$epoch"
  else
    date -d "@$epoch" '+%Y-%m-%d %H:%M %Z' 2>/dev/null || printf '%s' "$epoch"
  fi
}

clean_text() {
  local value="$1"
  value="$(printf '%s' "$value" | sed $'s/\033\\[[0-9;?]*[ -\\/]*[@-~]//g')"
  value="${value//$'\r'/}"
  value="${value#${value%%[![:space:]]*}}"
  value="${value%${value##*[![:space:]]}}"
  printf '%s' "$value"
}

window_json() {
  local bucket="$1" label="$2" used="$3" reset="$4" observed="${5:-}"
  printf '{"bucket_id":"%s","label":"%s","used_percent":%s,"remaining_percent":%s,"reset_display":"%s"' \
    "$(json_escape "$bucket")" "$(json_escape "$label")" "$used" "$(percent_left "$used")" "$(json_escape "$reset")"
  [ -z "$observed" ] || printf ',"observed_at":"%s"' "$(json_escape "$observed")"
  printf '}'
}

field_number() {
  local text="$1" field="$2" rest
  case "$text" in *\"$field\":*) ;; *) return 1 ;; esac
  rest="${text#*\"$field\":}"
  rest="${rest# }"
  printf '%s' "${rest%%[^0-9.]*}"
}

field_string() {
  local text="$1" field="$2" rest
  case "$text" in *\"$field\":\"*) ;; *) return 1 ;; esac
  rest="${text#*\"$field\":\"}"
  printf '%s' "${rest%%\"*}"
}

matching_object() {
  local text="$1" marker="$2" rest char depth=0 quoted=0 escaped=0 output=""
  case "$text" in *"$marker"*) ;; *) return 1 ;; esac
  rest="${text#*"$marker"}"
  while [ -n "$rest" ]; do
    char="${rest%"${rest#?}"}"
    rest="${rest#?}"
    output="$output$char"
    if [ "$escaped" -eq 1 ]; then escaped=0; continue; fi
    if [ "$char" = '\' ] && [ "$quoted" -eq 1 ]; then escaped=1; continue; fi
    if [ "$char" = '"' ]; then quoted=$((1 - quoted)); continue; fi
    [ "$quoted" -eq 0 ] || continue
    [ "$char" != '{' ] || depth=$((depth + 1))
    if [ "$char" = '}' ]; then
      depth=$((depth - 1))
      [ "$depth" -ne 0 ] || { printf '%s' "$output"; return 0; }
    fi
  done
  return 1
}

codex_usage() {
  local output line limits rest key object primary secondary first=1 windows=""
  if [ -n "${JAMSESSION_USAGE_FIXTURE_DIR:-}" ]; then
    [ -f "$JAMSESSION_USAGE_FIXTURE_DIR/codex.json" ] || return 1
    output="$(cat "$JAMSESSION_USAGE_FIXTURE_DIR/codex.json")"
  else
    command -v "${JAMSESSION_CODEX_BIN:-codex}" >/dev/null 2>&1 || return 1
    output="$({
      printf '%s\n' '{"method":"initialize","id":1,"params":{"clientInfo":{"name":"jamsession","title":"Jam Session","version":"1"},"capabilities":{"experimentalApi":true,"requestAttestation":false}}}'
      printf '%s\n' '{"method":"account/rateLimits/read","id":2}'
      sleep 2
    } | "${JAMSESSION_CODEX_BIN:-codex}" app-server --stdio 2>/dev/null)"
  fi
  line="$(printf '%s\n' "$output" | grep '"id":2' | tail -1)"
  limits="$(matching_object "$line" '"rateLimitsByLimitId":')" || return 1
  rest="${limits#\{}"; rest="${rest%\}}"
  while [ -n "$rest" ]; do
    case "$rest" in \"*\":\{*) ;; *) break ;; esac
    key="${rest#\"}"; key="${key%%\"*}"
    object="$(matching_object "$rest" ':')" || break
    primary="$(matching_object "$object" '"primary":')" || primary=""
    secondary="$(matching_object "$object" '"secondary":')" || secondary=""
    label="$(field_string "$object" limitName || true)"; [ -n "$label" ] || label="$key"
    for slot in primary secondary; do
      eval "part=\$$slot"
      [ -n "$part" ] || continue
      used="$(field_number "$part" usedPercent || true)"; [ -n "$used" ] || continue
      reset="$(field_number "$part" resetsAt || true)"
      [ "$first" -eq 1 ] || windows="$windows,"
      [ "$slot" = primary ] || slot_label="$label secondary"
      [ "$slot" != primary ] || slot_label="$label"
      windows="$windows$(window_json "$key:$slot" "$slot_label" "$used" "$(format_epoch "$reset")")"
      first=0
    done
    rest="${rest#*"$object"}"; rest="${rest#,}"
  done
  [ -n "$windows" ] || return 1
  printf '%s' "$windows"
}

capture_tui() {
  local provider="$1" output="$TEMP_DIR/$provider.raw" command_string="" arg pid deadline
  shift
  if [ -n "${JAMSESSION_USAGE_FIXTURE_DIR:-}" ]; then
    CAPTURE_FILE="$JAMSESSION_USAGE_FIXTURE_DIR/$provider.txt"
    [ -f "$CAPTURE_FILE" ] || return 1
    return
  fi
  command -v script >/dev/null 2>&1 || return 1
  for arg in "$@"; do printf -v command_string '%s %q' "$command_string" "$arg"; done
  if [ "$(uname -s)" = Darwin ]; then
    { feed_tui "$provider" | script -qF "$output" "$@"; } \
      >"$TEMP_DIR/$provider.stdout" 2>"$TEMP_DIR/$provider.script.err" &
  else
    { feed_tui "$provider" | script -qf -c "${command_string# }" "$output"; } \
      >"$TEMP_DIR/$provider.stdout" 2>"$TEMP_DIR/$provider.script.err" &
  fi
  pid=$!
  CAPTURE_PID=$pid
  deadline=$((SECONDS + TIMEOUT))
  while kill -0 "$pid" 2>/dev/null && [ "$SECONDS" -lt "$deadline" ]; do
    case "$provider" in
      claude) grep -q 'Current week (Fable)' "$output" 2>/dev/null && break ;;
      cursor) grep -Eq 'plan [0-9.]+% left|Included.*% used' "$output" 2>/dev/null && break ;;
      grok) grep -q 'Weekly limit' "$output" 2>/dev/null && break ;;
    esac
    sleep 1
  done
  # `script` starts its own session, so killing only this pipeline subshell
  # leaves the usage TUI reparented to launchd. Stop the whole descendant tree,
  # then anything still named with this capture file.
  stop_pid_tree "$pid"
  extra_pids="$(ps -axo pid=,command= | awk -v out="$output" 'index($0, out) { print $1 }')"
  if [ -n "$extra_pids" ]; then
    printf '%s\n' "$extra_pids" | while IFS= read -r extra_pid; do
      [ -n "$extra_pid" ] || continue
      stop_pid_tree "$extra_pid"
    done
  fi
  wait "$pid" 2>/dev/null || true
  CAPTURE_PID=""
  [ -s "$output" ] || return 1
  CAPTURE_FILE="$output"
}

tui_usage() {
  local provider="$1" binary="$2" text python_bin="${JAMSESSION_PYTHON_BIN:-python3}" helper="$SCRIPT_DIR/jamsession_tui_usage.py"
  if [ -n "${JAMSESSION_USAGE_FIXTURE_DIR:-}" ]; then
    CAPTURE_FILE="$JAMSESSION_USAGE_FIXTURE_DIR/$provider.txt"
    [ -f "$CAPTURE_FILE" ] || return 1
    cat "$CAPTURE_FILE"
    return
  fi
  command -v "$python_bin" >/dev/null 2>&1 || return 1
  [ -f "$helper" ] || return 1
  text="$("$python_bin" "$helper" "$provider" "$binary" "$TIMEOUT")" || return $?
  [ -n "$text" ] || return 1
  printf '%s' "$text"
}

feed_tui() {
  local provider="$1"
  sleep 3
  printf '/usage\r'
  # Claude can render Fable after the other windows. Keep its input stream open
  # until capture_tui sees that final window or reaches its timeout.
  if [ "$provider" = claude ]; then sleep "$TIMEOUT"; return; fi
  if [ "$provider" = cursor ]; then sleep 2; printf '\r'; fi
  sleep 5
  printf '\033'
  sleep 1
  printf '/exit\r'
  sleep 1
  printf '\004'
}

text_windows() {
  local provider="$1" text="$2" line heading="" used="" reset="not exposed" windows="" first=1 label bucket seen="|" observed=""
  while IFS= read -r line; do
    line="$(clean_text "$line")"
    case "$line" in 'Observed at: '*) observed="${line#Observed at: }"; continue ;; esac
    if [ -n "$used" ]; then
      case "$line" in
        *Resets:*) reset="${line#*Resets:}" ;;
        *Resets*) reset="${line#*Resets}" ;;
        *) continue ;;
      esac
      reset="$(clean_text "$reset")"
      bucket="${heading%%|*}"; label="${heading#*|}"
      [ "$first" -eq 1 ] || windows="$windows,"
      windows="$windows$(window_json "$bucket" "$label" "$used" "$reset" "$observed")"
      seen="$seen$bucket|"; first=0; heading=""; used=""; reset="not exposed"
      continue
    fi
    case "$line" in
      *"Current session"*) heading="current_session|Current session" ;;
      *"Current week (all models)"*) heading="weekly_all|Current week (all models)" ;;
      *"Current week (Fable)"*) heading="weekly_fable|Current week (Fable)" ;;
      *"Included"*) heading="monthly_included|Monthly Included" ;;
      *"Auto"*) heading="monthly_auto|Monthly Auto" ;;
      *"API"*) heading="monthly_api|Monthly API" ;;
      *"Weekly limit"*) heading="weekly|Weekly limit" ;;
      *"AI credits"*) heading="monthly_credits|Monthly AI credits" ;;
      *"premium requests"*) heading="monthly_premium|Monthly premium requests" ;;
      'Subscription ('*) heading="subscription|$line" ;;
      'Subscription window') heading="subscription_window|Subscription window" ;;
      'Subscription weekly') heading="subscription_weekly|Subscription weekly" ;;
      'Model quota: '*) heading="${line#Model quota: }|${line#Model quota: }" ;;
      Plan) heading="monthly_plan|Monthly plan" ;;
    esac
    if [[ "$line" =~ ([0-9]+([.][0-9]+)?)%[[:space:]]+used ]]; then
      used="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ plan[[:space:]]+([0-9]+([.][0-9]+)?)%[[:space:]]+left ]]; then
      heading="monthly_plan|Monthly plan"
      used="$(awk -v left="${BASH_REMATCH[1]}" 'BEGIN { printf "%g", 100-left }')"
    else
      continue
    fi
    if [ -z "$heading" ]; then
      used=""
      continue
    fi
    bucket="${heading%%|*}"; label="${heading#*|}"
    [ -n "$bucket" ] || continue
    case "$seen" in *"|$bucket|"*) heading=""; used=""; continue ;; esac
    case "$line" in
      *Resets:*) reset="${line#*Resets:}" ;;
      *Resets*) reset="${line#*Resets}" ;;
    esac
    reset="$(clean_text "$reset")"
    if [ "$provider" != cursor ] && [ "$provider" != copilot ] && [ "$reset" = "not exposed" ]; then
      continue
    fi
    [ "$first" -eq 1 ] || windows="$windows,"
    windows="$windows$(window_json "$bucket" "$label" "$used" "$reset" "$observed")"
    seen="$seen$bucket|"
    first=0
    heading=""; used=""; reset="not exposed"
  done <<<"$text"
  [ -n "$windows" ] || return 1
  printf '%s' "$windows"
}

provider_usage() {
  local provider="$1" text
  PROVIDER_WINDOWS=""
  PROVIDER_ERROR_CODE="usage_unavailable"
  PROVIDER_ERROR_MESSAGE="usage could not be read"
  case "$provider" in
    codex)
      PROVIDER_WINDOWS="$(codex_usage)" || {
        sleep 1
        PROVIDER_WINDOWS="$(codex_usage)" || return 1
      }
      ;;
    claude)
      capture_tui claude "${JAMSESSION_CLAUDE_BIN:-claude}" --ax-screen-reader --safe-mode --permission-mode plan || return 1
      text="$(cat "$CAPTURE_FILE")"
      PROVIDER_WINDOWS="$(text_windows claude "$text")" || return 1
      ;;
    cursor)
      capture_tui cursor "${JAMSESSION_CURSOR_BIN:-cursor-agent}" --mode ask --trust || return 1
      text="$(cat "$CAPTURE_FILE")"
      PROVIDER_WINDOWS="$(text_windows cursor "$text")" || return 1
      ;;
    grok)
      text="$(tui_usage grok "${JAMSESSION_GROK_BIN:-grok}")" || return 1
      PROVIDER_WINDOWS="$(text_windows grok "$text")" || return 1
      ;;
    copilot)
      text="$(tui_usage copilot "${JAMSESSION_COPILOT_BIN:-copilot}")" || return 1
      PROVIDER_WINDOWS="$(text_windows copilot "$text")" || return 1
      ;;
    devin)
      text="$(tui_usage devin "${JAMSESSION_DEVIN_BIN:-devin}")" || return 1
      PROVIDER_WINDOWS="$(text_windows devin "$text")" || return 1
      ;;
    muse)
      local read_status=0
      text="$(tui_usage muse "${JAMSESSION_MUSE_BIN:-muse}")" || read_status=$?
      if [ "$read_status" -eq 3 ]; then
        PROVIDER_ERROR_CODE="usage_not_observed"
        PROVIDER_ERROR_MESSAGE="Muse has no current subscription quota observation from usage/read or /usage; session tokens are not quota; no model call was made"
      fi
      [ "$read_status" -eq 0 ] || return 1
      PROVIDER_WINDOWS="$(text_windows muse "$text")" || return 1
      ;;
    antigravity)
      text="$(tui_usage antigravity "${JAMSESSION_ANTIGRAVITY_BIN:-agy}")" || return 1
      PROVIDER_WINDOWS="$(text_windows antigravity "$text")" || return 1
      ;;
    *) return 1 ;;
  esac
}

collect_provider() {
  local provider="$1" slot="${2:-$1}" account="${3:-}" windows identity
  if [ -n "$account" ]; then
    identity="$(printf '{"agent":"%s","account":"%s"' "$provider" "$(json_escape "$account")")"
  else
    identity="$(printf '{"agent":"%s"' "$provider")"
  fi
  if provider_usage "$provider"; then
    windows="$PROVIDER_WINDOWS"
    printf '%s' "$windows" >"$TEMP_DIR/$slot.windows"
    printf '%s,"status":"ok","windows":[%s],"error":null}' \
      "$identity" "$windows" >"$TEMP_DIR/$slot.json"
    printf 'ok' >"$TEMP_DIR/$slot.result"
  else
    printf '%s,"status":"unavailable","windows":[],"error":{"code":"%s","message":"%s"}}' \
      "$identity" "$PROVIDER_ERROR_CODE" "$(json_escape "$PROVIDER_ERROR_MESSAGE")" >"$TEMP_DIR/$slot.json"
    printf 'unavailable' >"$TEMP_DIR/$slot.result"
  fi
}

accounts_py() {
  if [ -f "$SCRIPT_DIR/jamsession_accounts.py" ]; then
    printf '%s\n' "$SCRIPT_DIR/jamsession_accounts.py"
    return 0
  fi
  if [ -f "$SCRIPT_DIR/../usage/jamsession_accounts.py" ]; then
    printf '%s\n' "$SCRIPT_DIR/../usage/jamsession_accounts.py"
    return 0
  fi
  return 1
}

accounts_toml() {
  if [ -n "${JAMSESSION_ACCOUNTS+x}" ]; then
    printf '%s\n' "$JAMSESSION_ACCOUNTS"
  else
    printf '%s\n' "$HOME/.agents/jamsession/accounts.toml"
  fi
}

# Exports one account's env inside the caller's subshell, so the next account
# does not inherit it.
apply_account_env() {
  local provider="$1" account="$2" helper output line key value status=0
  [ -n "$account" ] || return 0
  helper="$(accounts_py)" || return 1
  output="$("${JAMSESSION_PYTHON_BIN:-python3}" "$helper" env "$provider" "$account" 2>"$TEMP_DIR/$provider.$account.env.err")" || status=$?
  [ "$status" -eq 0 ] || return "$status"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    key=${line%%=*}
    value=${line#*=}
    printf -v "$key" '%s' "$value"
    export "$key"
  done <<<"$output"
}

main() {
  local json=0 requested="" requested_account="" spec provider account windows row
  local first=1 successes=0 failures=0 rows="" human_file account_list slot label width=9 saw_account=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      *)
        [ -z "$requested" ] || fail "choose at most one provider"
        spec="$1"
        requested_account=""
        case "$spec" in
          *:*)
            requested_account="${spec#*:}"
            spec="${spec%%:*}"
            [ -n "$requested_account" ] && [ "$requested_account" = "${requested_account%%:*}" ] || fail "invalid account '$1'"
            ;;
        esac
        case "$spec" in
          copilot|codex|claude|cursor|grok|devin|muse|antigravity|agy|gemini)
            requested="$spec"
            case "$requested" in agy|gemini) requested=antigravity ;; esac
            ;;
          *) fail "unknown argument '$1'" ;;
        esac
        ;;
    esac
    shift
  done
  make_temp
  human_file="$TEMP_DIR/human"
  : >"$human_file"
  : >"$TEMP_DIR/manifest"
  [ -n "$requested" ] && providers="$requested" || providers="$PROVIDERS"
  for provider in $providers; do
    account_list=""
    if [ -f "$(accounts_toml)" ]; then
      account_list="$("${JAMSESSION_PYTHON_BIN:-python3}" "$(accounts_py)" list "$provider")" || fail "could not read accounts for $provider"
    elif [ -n "$requested_account" ]; then
      fail "$provider has no account '$requested_account'; $(accounts_toml) is missing"
    fi
    if [ -n "$requested_account" ]; then
      case "
$account_list
" in
        *"
$requested_account
"*) ;;
        *) fail "$provider has no account '$requested_account'" ;;
      esac
      account_list="$requested_account"
    fi
    if [ -z "$account_list" ]; then
      printf '%s %s %s\n' "$provider" "$provider" "" >>"$TEMP_DIR/manifest"
      collect_provider "$provider" "$provider" "" 2>"$TEMP_DIR/$provider.collect.err" &
    else
      saw_account=1
      # One provider's accounts run in series so each env stays inside its own
      # subshell and they do not share a capture file. Providers still overlap.
      (
        while IFS= read -r account; do
          [ -n "$account" ] || continue
          slot="$provider.$account"
          (
            if apply_account_env "$provider" "$account"; then
              collect_provider "$provider" "$slot" "$account"
            else
              printf '{"agent":"%s","account":"%s","status":"unavailable","windows":[],"error":{"code":"usage_unavailable","message":"could not read account env"}}' \
                "$provider" "$account" >"$TEMP_DIR/$slot.json"
              printf 'unavailable' >"$TEMP_DIR/$slot.result"
            fi
          ) 2>"$TEMP_DIR/$slot.collect.err"
        done <<<"$account_list"
      ) &
      while IFS= read -r account; do
        [ -n "$account" ] || continue
        printf '%s %s %s\n' "$provider.$account" "$provider" "$account" >>"$TEMP_DIR/manifest"
      done <<<"$account_list"
    fi
  done
  wait
  [ "$saw_account" -eq 0 ] || width=18
  while read -r slot provider account; do
    [ -n "$slot" ] || continue
    [ -f "$TEMP_DIR/$slot.json" ] || continue
    row="$(cat "$TEMP_DIR/$slot.json")"
    label="$provider"
    [ -z "$account" ] || label="$provider/$account"
    if [ "$(cat "$TEMP_DIR/$slot.result")" = ok ]; then
      windows="$(cat "$TEMP_DIR/$slot.windows")"
      successes=$((successes + 1))
      printf '%s\n' "$windows" | sed 's/},{/}\n{/g' | while IFS= read -r window; do
        window_label="$(field_string "$window" label || true)"
        remaining="$(field_number "$window" remaining_percent || true)"
        reset="$(field_string "$window" reset_display || true)"
        observed="$(field_string "$window" observed_at || true)"
        [ -z "$observed" ] || reset="$reset [usage as of $observed]"
        printf "%-${width}s %-30s %-12s %s\n" "$label" "$window_label" "${remaining}%" "$reset" >>"$human_file"
        label=""
      done
    else
      failures=$((failures + 1))
      printf "%-${width}s unavailable (%s)\n" "$label" "$(field_string "$row" message || true)" >>"$human_file"
    fi
    [ "$first" -eq 1 ] || rows="$rows,"
    rows="$rows$row"; first=0
  done <"$TEMP_DIR/manifest"
  [ "$failures" -eq 0 ] && status=complete || { [ "$successes" -eq 0 ] && status=failed || status=partial; }
  report="{\"schema_version\":1,\"status\":\"$status\",\"providers\":[$rows]}"
  if [ "$json" -eq 1 ]; then
    printf '%s\n' "$report"
  else
    printf 'Jam Session usage (%s)\n\n' "$status"
    printf "%-${width}s %-30s %-12s %s\n" Provider Window Remaining Reset
    cat "$human_file"
  fi
  cleanup
  [ "$failures" -eq 0 ] && return 0
  [ "$successes" -eq 0 ] && return 1
  return 2
}

main "$@"
