#!/usr/bin/env bash

set -u

ADAPTER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_jamsession_adapter_common
source "$ADAPTER_DIR/_jamsession_adapter_common"
jamsession_adapter_setup codex codex JAMSESSION_CODEX_BIN

help_text() {
  cat <<'EOF'
jamsession_codex

Run:    jamsession_codex run <new|session> <model> <effort> <read|edit> <prompt>
Other:  jamsession_codex <list|which|models|message|steer|usage|status|doctor|help>

Prefer run <session> <model> <effort> <read|edit> <prompt> for follow-up work.
Run starts/resumes first and waits for a result. Only a confirmed pre-input busy
or ownership refusal falls back to a queue, once. Queued work keeps the owner's
settings, not the requested run settings. Read runs refuse this fallback because
the queue cannot enforce their sandbox. Denials and uncertain sends never retry.
Message: jamsession_codex message <session> <text> starts idle work; queues only if busy/owned.
Steer:   jamsession_codex steer <session> <text> redirects active work or starts an idle session.
Optional --resume-with settings are validated but unused by native delivery.
Native control needs system Python 3 and starts Codex's own local daemon if needed.
No Jam Session daemon or permission changes are introduced. Another owning process
receives messages through codex queue; its queue consumer controls delivery. It
cannot be steered through this adapter unless its control socket is available.
An idle desktop owner may leave its queue pending until the session is focused.
`delivery: queued; execution unconfirmed` is not a started run or a final answer.
Use steer for intentional redirection. Serialize follow-ups to the same session:
Codex has no atomic idle-only start, so concurrent senders can race into steering.
The saved approval/reviewer policy is retained.
See `jamsession help message` for delivery states and ownership limits.

Fresh edit mode inherits Codex's native configuration and approval policy.
JAMSESSION_CODEX_PROFILE selects a native config profile. JAMSESSION_CODEX_CONFIG
is a Bash array of native key=value overrides in jamsession.conf. Explicit
JAMSESSION_CODEX_SANDBOX (read-only/workspace-write/danger-full-access) overrides
that array. Legacy sandbox=off means
danger-full-access/never for edit only; on/inherit add no overrides.
Read always requests read-only, even when sandbox=off. CLI read also forces never;
control read retains saved approval/reviewer policy. Managed requirements
still apply; configuration errors or denials never select weaker settings.
Control resumes keep saved permissions, including cold-start restoration checks.
Explicit launch overrides select native CLI resume before connecting to control;
native Codex validates them. Busy delivery still retains the owner's settings.
Profiles must have a readable $CODEX_HOME/<name>.config.toml file (default
~/.codex). Native launches use --strict-config; unsupported config/version fails.
Run `jamsession help configure` for precedence and configuration examples.
`models` reads `codex debug models` and prints listed models with their efforts.
`list [count]` uses native control to list recent sessions in the current directory,
including exec sessions. It prints ID and this controller's runtime status, not
global desktop availability. Absence is not proof a session does not exist; use
`which <session>` for an exact known ID. Listing never resumes a session.
Cold restores ignore legacy ID-less settings only when a later verified settings
record exists. Explicit foreign IDs, conflicting headers and unrepresentable
permissions still fail before input. Started means native turn acceptance, not
proof the recipient read the task or completed it; verify its turn/reply.
EOF
}

which_transcript() {
  jamsession_validate_which "$@"
  local root="${CODEX_HOME:-$HOME/.codex}" path=""
  if [ -n "$JAMSESSION_WHICH_SESSION" ]; then
    path="$(find "$root/sessions" "$root/archived_sessions" -type f -name "*-$JAMSESSION_WHICH_SESSION.jsonl" -print -quit 2>/dev/null)"
    [ -n "$path" ] || jamsession_die "session '$JAMSESSION_WHICH_SESSION' was not found under $root"
  else
    path="$root/sessions"
  fi
  printf 'path: %s\nformat: JSONL\n' "$path"
  if [ -n "$JAMSESSION_WHICH_SESSION" ]; then
    printf 'read: less %q\n' "$path"
  else
    printf 'find: find %q -type f -name '\''*.jsonl'\''\n' "$path"
  fi
}

# Codex records each model call's usage; the latest total is the live context.
session_size() {
  local root="${CODEX_HOME:-$HOME/.codex}" path line
  path="$(find "$root/sessions" "$root/archived_sessions" -type f -name "*-$1.jsonl" -print -quit 2>/dev/null)"
  line="$([ -z "$path" ] || grep -F '"last_token_usage":{' "$path" | tail -n 1)"
  jamsession_session_size "$(jamsession_json_number "${line##*\"last_token_usage\":\{}" total_tokens)"
}

list_models() {
  local python_bin="${JAMSESSION_PYTHON_BIN:-python3}" catalog
  command -v "$python_bin" >/dev/null 2>&1 || jamsession_die "Codex model listing needs python3 to read 'codex debug models'"
  catalog="$("$JAMSESSION_PROVIDER_BIN" debug models 2>/dev/null)" || jamsession_die "could not read 'codex debug models'"
  printf '%s' "$catalog" | "$python_bin" -c '
import json, sys
for m in json.load(sys.stdin).get("models", []):
    if m.get("visibility") != "list": continue
    efforts = ", ".join(e["effort"] for e in m.get("supported_reasoning_levels", []))
    print("%s - %s - %s (efforts: %s; default %s)" % (m["slug"], m.get("display_name", m["slug"]), m.get("description", ""), efforts, m.get("default_reasoning_level", "default")))
' || jamsession_die "could not parse 'codex debug models' output"
}

run_agent() {
  jamsession_validate_run "$@"
  jamsession_require_binary

  [ "$JAMSESSION_SESSION" != "${CODEX_THREAD_ID:-}" ] || \
    jamsession_die "cannot synchronously resume your own live session; use message or steer"
  local -a launch_options=()
  local override declaration
  if [ -n "${JAMSESSION_CODEX_PROFILE:-}" ]; then
    case "$JAMSESSION_CODEX_PROFILE" in .|..|*[!a-zA-Z0-9_.-]*) jamsession_die "Codex profile must be a simple profile-file name" ;; esac
    [ -r "${CODEX_HOME:-$HOME/.codex}/$JAMSESSION_CODEX_PROFILE.config.toml" ] || \
      jamsession_die "Codex profile file is missing or unreadable: $JAMSESSION_CODEX_PROFILE.config.toml; refusing native default fallback"
    launch_options+=(--profile "$JAMSESSION_CODEX_PROFILE")
  fi
  if declaration="$(declare -p JAMSESSION_CODEX_CONFIG 2>/dev/null)"; then
    case "$declaration" in 'declare -a '*) ;; *) jamsession_die "JAMSESSION_CODEX_CONFIG must be a Bash array in jamsession.conf" ;; esac
    if [ "${#JAMSESSION_CODEX_CONFIG[@]}" -gt 0 ]; then
      for override in "${JAMSESSION_CODEX_CONFIG[@]}"; do
        case "$override" in *=*) launch_options+=(-c "$override") ;; *) jamsession_die "Codex config overrides must be key=value" ;; esac
      done
    fi
  fi
  case "${JAMSESSION_CODEX_SANDBOX:-inherit}" in
    on|inherit) ;;
    off) launch_options+=(-c 'sandbox_mode="danger-full-access"' -c 'approval_policy="never"') ;;
    read-only|workspace-write|danger-full-access) launch_options+=(-c "sandbox_mode=\"$JAMSESSION_CODEX_SANDBOX\"") ;;
    *) jamsession_die "unsupported JAMSESSION_CODEX_SANDBOX; use inherit, on, off, read-only, workspace-write or danger-full-access" ;;
  esac
  local control_socket="${JAMSESSION_CODEX_CONTROL_SOCKET:-${CODEX_HOME:-$HOME/.codex}/app-server-control/app-server-control.sock}"
  if [ "$JAMSESSION_SESSION" != new ] && [ -S "$control_socket" ] && [ "${#launch_options[@]}" -eq 0 ]; then
    local python_bin="${JAMSESSION_PYTHON_BIN:-python3}" control_status=0
    command -v "$python_bin" >/dev/null 2>&1 || jamsession_die "Codex control resume needs system Python 3"
    export JAMSESSION_CODEX_CONTROL_SOCKET JAMSESSION_CWD
    printf '%s' "$JAMSESSION_PROMPT" | "$python_bin" "$ADAPTER_DIR/_jamsession_codex_control.py" \
      "$JAMSESSION_PROVIDER_BIN" run "$JAMSESSION_SESSION" "$JAMSESSION_MODEL" \
      "$JAMSESSION_EFFORT" "$JAMSESSION_ACCESS" || control_status=$?
    if [ "$control_status" -eq 4 ]; then
      queue_busy_run
      return $?
    fi
    if [ "$control_status" -ne 3 ]; then
      jamsession_session "$JAMSESSION_SESSION"
      session_size "$JAMSESSION_SESSION"
      return "$control_status"
    fi
    printf 'delivery: control server unavailable; using guarded native CLI resume\n' >&2
  fi

  local temp_events temp_last temp_error status session_id line
  local -a command_args
  jamsession_make_temp_dir
  temp_events="$JAMSESSION_TEMP_DIR/events"
  temp_last="$JAMSESSION_TEMP_DIR/last"
  temp_error="$JAMSESSION_TEMP_DIR/error"
  : >"$temp_events"; : >"$temp_last"; : >"$temp_error"

  if [ "$JAMSESSION_SESSION" = new ]; then
    command_args=(exec --strict-config --json --skip-git-repo-check -C "$JAMSESSION_CWD" -o "$temp_last")
  else
    command_args=(exec resume --strict-config --json --skip-git-repo-check -o "$temp_last")
  fi
  [ "$JAMSESSION_MODEL" = default ] || command_args+=(-m "$JAMSESSION_MODEL")
  [ "$JAMSESSION_EFFORT" = default ] || command_args+=(-c "model_reasoning_effort=$JAMSESSION_EFFORT")

  if [ "$JAMSESSION_ACCESS" = read ]; then
    if [ "$JAMSESSION_SESSION" = new ]; then
      command_args+=(-s read-only)
    else
      command_args+=(-c 'sandbox_mode="read-only"')
    fi
    command_args+=(-c 'approval_policy="never"')
    command_args+=(-c 'default_permissions=":read-only"')
    jamsession_hint "Codex is running in its read-only sandbox."
  else
    jamsession_hint "Codex edit permissions come from native config/profile and explicit launch overrides; no implicit workspace-write or approval-policy override."
  fi
  if [ "${#launch_options[@]}" -gt 0 ]; then
    command_args=("${launch_options[@]}" "${command_args[@]}")
  fi

  if [ "$JAMSESSION_SESSION" = new ]; then
    command_args+=("$JAMSESSION_PROMPT")
  else
    command_args+=("$JAMSESSION_SESSION" "$JAMSESSION_PROMPT")
  fi

  status=0
  (cd "$JAMSESSION_CWD" && "$JAMSESSION_PROVIDER_BIN" "${command_args[@]}" </dev/null >"$temp_events" 2>"$temp_error") || status=$?
  if [ "$status" -ne 0 ] && [ "$JAMSESSION_SESSION" != new ] && \
    [ ! -s "$temp_events" ] && [ ! -s "$temp_last" ] && \
    grep -Fxq "Error: thread/resume: thread/resume failed: thread $JAMSESSION_SESSION already has an active writer (code -32600)" "$temp_error"; then
    queue_busy_run cli
    exit $?
  fi
  [ ! -s "$temp_error" ] || cat "$temp_error" >&2

  session_id=""
  while IFS= read -r line; do
    session_id="$line"
    break
  done < <(sed -n 's/.*"thread_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$temp_events")
  [ -n "$session_id" ] || [ "$JAMSESSION_SESSION" = new ] || session_id="$JAMSESSION_SESSION"
  if [ -n "$session_id" ]; then
    jamsession_session "$session_id"
  else
    printf 'jamsession_codex: provider returned no session identifier\n' >&2
  fi

  if [ -s "$temp_last" ]; then
    cat "$temp_last"
    printf '\n'
  elif [ "$status" -ne 0 ] && [ -s "$temp_events" ]; then
    cat "$temp_events" >&2
  fi
  [ -z "$session_id" ] || session_size "$session_id"
  exit "$status"
}

queue_busy_run() {
  local busy_status=0
  [ "$JAMSESSION_ACCESS" != read ] || \
    jamsession_die "session is busy/owned; cannot enforce read access through its queue; no message queued"
  printf 'delivery: run refused as busy/owned; falling back to native delivery\n' >&2
  printf 'warning: queued work keeps the owner\047s model, effort, workspace and permissions; requested run settings do not apply\n' >&2
  if [ "${1:-control}" = cli ]; then
    native_queue "$JAMSESSION_SESSION" "$JAMSESSION_PROMPT" || busy_status=$?
  else
    deliver_message message "$JAMSESSION_SESSION" "$JAMSESSION_PROMPT" || busy_status=$?
  fi
  jamsession_session "$JAMSESSION_SESSION"
  session_size "$JAMSESSION_SESSION"
  return "$busy_status"
}

native_queue() {
  local queue_status=0
  (cd "$JAMSESSION_CWD" && "$JAMSESSION_PROVIDER_BIN" queue \
    --thread "$1" --message "$2") || queue_status=$?
  if [ "$queue_status" -eq 0 ]; then
    printf 'delivery: queued; execution unconfirmed (another process owns the session)\n' >&2
    printf 'warning: an idle desktop owner may not consume this until its session is focused; do not resend\n' >&2
  fi
  return "$queue_status"
}

deliver_message() {
  local intent="$1" python_bin="${JAMSESSION_PYTHON_BIN:-python3}" status=0
  shift
  [ "$intent" != steer ] || [ $# -eq 2 ] || jamsession_die "steer needs <session> <text>"
  jamsession_validate_message "$@"
  jamsession_require_binary
  jamsession_native_message_settings
  command -v "$python_bin" >/dev/null 2>&1 || jamsession_die "Codex messaging needs system Python 3"
  export JAMSESSION_CODEX_CONTROL_SOCKET
  printf '%s' "$JAMSESSION_PROMPT" | "$python_bin" "$ADAPTER_DIR/_jamsession_codex_control.py" \
    "$JAMSESSION_PROVIDER_BIN" "$intent" "$JAMSESSION_MESSAGE_SESSION" || status=$?
  if [ "$status" -eq 4 ]; then
    [ "$intent" = message ] || jamsession_unsupported "steer: the session belongs to another controller"
    native_queue "$JAMSESSION_MESSAGE_SESSION" "$JAMSESSION_PROMPT"
    return $?
  fi
  return "$status"
}

case "${1:-help}" in
  message|steer) intent="$1"; shift; deliver_message "$intent" "$@" ;;
  run) shift; run_agent "$@" ;;
  which) shift; which_transcript "$@" ;;
  models) jamsession_require_binary; list_models ;;
  list)
    shift
    [ $# -le 1 ] || jamsession_die "list takes an optional count"
    count="${1:-5}"
    jamsession_positive_count "$count"
    jamsession_require_binary
    python_bin="${JAMSESSION_PYTHON_BIN:-python3}"
    command -v "$python_bin" >/dev/null 2>&1 || jamsession_die "Codex listing needs system Python 3"
    export JAMSESSION_CWD
    "$python_bin" "$ADAPTER_DIR/_jamsession_codex_control.py" "$JAMSESSION_PROVIDER_BIN" list "$count"
    ;;
  usage|status) jamsession_unsupported "$1" ;;
  doctor)
    jamsession_require_binary
    "$JAMSESSION_PROVIDER_BIN" --version
    "$JAMSESSION_PROVIDER_BIN" login status
    ;;
  help|-h|--help) help_text ;;
  *) jamsession_die "unknown command '$1'" ;;
esac
