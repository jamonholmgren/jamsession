#!/usr/bin/env bash

set -u

ADAPTER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_jamsession_adapter_common
source "$ADAPTER_DIR/_jamsession_adapter_common"
jamsession_adapter_setup grok grok JAMSESSION_GROK_BIN

GROK_NOT_AUTHENTICATED='^[[:space:]]*(error:[[:space:]]*)?(you are |you.re )?(not authenticated|not logged in|not signed in)([[:space:].!,:;]|$)'

# `grok models` answers from the expired token while its silent refresh is still
# in flight, so the first call after the 6-hour token lapses prints "not
# authenticated" and the bundled catalog. The refresh lands within a second;
# one retry reads the real login and catalog. A second refusal is real.
grok_models() {
  local output status=0
  output="$("$JAMSESSION_PROVIDER_BIN" models 2>&1)" || status=$?
  if printf '%s\n' "$output" | grep -Eiq "$GROK_NOT_AUTHENTICATED"; then
    sleep 1
    status=0
    output="$("$JAMSESSION_PROVIDER_BIN" models 2>&1)" || status=$?
  fi
  printf '%s\n' "$output"
  return "$status"
}

help_text() {
  cat <<'EOF'
jamsession_grok

Run:    jamsession_grok run <new|session> <model> <effort> <read|edit> <prompt>
Other:  jamsession_grok <list|which|models|message|usage|status|doctor|help>

Message: message <session> <text> --resume-with <model> <effort> <read|edit>
resumes once, not queued. Stop the owning process first; ownership cannot be
verified. See `jamsession help message` and `jamsession help watch`.

Grok edit mode uses bypassPermissions because headless approval modes can end a
session without returning its answer. This adapter rejects read mode: Grok's
current read-only controls do not reliably prevent shell writes. Grok reasoning
effort stops at high, so xhigh or max is an error rather than a quiet downgrade.

Doctor/status inspect `grok models`, without spending a prompt. A confirmed
login is reported as ready, not proof a task will run. A failed or unrecognized
catalog check is unverified, not a provider outage; the authorized task launch
is the decisive check. Explicit authentication errors still fail doctor.
EOF
}

which_transcript() {
  jamsession_validate_which "$@"
  local root="$HOME/.grok/sessions" path=""
  if [ -n "$JAMSESSION_WHICH_SESSION" ]; then
    path="$(jamsession_find_session_file "$root" "$JAMSESSION_WHICH_SESSION" events.jsonl)"
    [ -n "$path" ] || jamsession_die "session '$JAMSESSION_WHICH_SESSION' was not found under $root"
    printf 'path: %s\nformat: JSONL\nread: grok export %q\n' "$path" "$JAMSESSION_WHICH_SESSION"
  else
    printf 'path: %s\nformat: per-session JSONL directories\nread: grok sessions list; grok export SESSION_ID\n' "$root"
  fi
  printf 'note: grok export may start or contact Grok\047s local leader daemon\n'
}

session_size() {
  local path
  path="$(jamsession_find_session_file "$HOME/.grok/sessions" "$1" signals.json)"
  jamsession_session_size "$([ -z "$path" ] || jamsession_json_number "$(cat "$path")" contextTokensUsed)"
}

run_agent() {
  jamsession_validate_run "$@"
  jamsession_require_binary
  if [ "$JAMSESSION_ACCESS" = read ]; then
    # Accepted exception: Grok cannot enforce read-only, so read runs with edit transport and a no-edits instruction.
    printf 'note: Grok has no enforced read-only mode; running with a no-edits instruction\n' >&2
    JAMSESSION_PROMPT="Do not modify, create, delete, rename, format, stage, or commit files; do not run state-changing commands.
$JAMSESSION_PROMPT"
  fi

  local session_id status
  local -a args
  args=(-p "$JAMSESSION_PROMPT" --cwd "$JAMSESSION_CWD" --output-format plain --permission-mode bypassPermissions)
  [ "$JAMSESSION_MODEL" = default ] || args+=(-m "$JAMSESSION_MODEL")
  case "$JAMSESSION_EFFORT" in
    default) ;;
    xhigh|max) jamsession_die "Grok supports up to high effort; pass high or default" ;;
    none) jamsession_die "Grok has no none effort; pass default or a supported effort" ;;
    *) args+=(--reasoning-effort "$JAMSESSION_EFFORT") ;;
  esac

  if [ "$JAMSESSION_SESSION" = new ]; then
    session_id="$(jamsession_uuid)" || exit $?
    args+=(--session-id "$session_id")
  else
    session_id="$JAMSESSION_SESSION"
    args+=(--resume "$session_id")
  fi

  jamsession_hint "Grok bypassPermissions may act beyond the workspace; use a trusted environment."
  jamsession_session "$session_id"
  status=0
  "$JAMSESSION_PROVIDER_BIN" "${args[@]}" </dev/null || status=$?
  session_size "$session_id"
  exit "$status"
}

case "${1:-help}" in
  message)
    shift; jamsession_validate_message "$@"
    [ "$JAMSESSION_MESSAGE_RESUME" -eq 1 ] || jamsession_unsupported message
    if [ -n "${GROK_SESSION_ID:-}" ] && [ "$JAMSESSION_MESSAGE_SESSION" = "$GROK_SESSION_ID" ]; then
      jamsession_die "cannot resume your own Grok session; use foreground watch"
    fi
    jamsession_resume_message
    ;;
  run) shift; run_agent "$@" ;;
  which) shift; which_transcript "$@" ;;
  list)
    shift
    [ $# -le 1 ] || jamsession_die "list takes an optional count"
    count="${1:-5}"; jamsession_positive_count "$count"
    jamsession_require_binary
    "$JAMSESSION_PROVIDER_BIN" sessions list --limit "$count"
    ;;
  models) jamsession_require_binary; grok_models ;;
  steer|usage|status) jamsession_unsupported "$1" ;;
  doctor)
    jamsession_require_binary
    "$JAMSESSION_PROVIDER_BIN" --version || exit $?
    doctor_status=0
    doctor_output="$(grok_models 2>&1)" || doctor_status=$?
    if printf '%s\n' "$doctor_output" | grep -Eiq "$GROK_NOT_AUTHENTICATED"; then
      printf 'authentication: rejected by grok models\n' >&2
      printf '%s\n' "$doctor_output" >&2
      exit 1
    elif [ "$doctor_status" -eq 0 ] && printf '%s\n' "$doctor_output" | grep -Eq '^You are logged in with .+\.$'; then
      printf 'authentication: ready (grok models reports logged in; task launch not tested)\n'
    else
      printf 'authentication: unverified (grok models exit %s; not proof Grok is unavailable)\n' "$doctor_status"
      printf 'Launch the authorized task to verify execution; do not switch providers based on this check alone.\n'
      [ -z "$doctor_output" ] || printf '%s\n' "$doctor_output" >&2
    fi
    ;;
  help|-h|--help) help_text ;;
  *) jamsession_die "unknown command '$1'" ;;
esac
