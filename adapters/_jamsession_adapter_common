#!/usr/bin/env bash

# Shared implementation details for bundled adapters. Custom adapters do not
# need to source this file; `jamsession make-adapter` creates a standalone script.

jamsession_adapter_setup() {
  JAMSESSION_PROVIDER="$1"
  JAMSESSION_DEFAULT_BIN="$2"
  JAMSESSION_BIN_VARIABLE="$3"
  JAMSESSION_CONFIG="${JAMSESSION_CONFIG:-${JAMSESSION_HOME:-$HOME/.agents/jamsession}/jamsession.conf}"
  if [ -f "$JAMSESSION_CONFIG" ]; then
    # shellcheck source=/dev/null
    source "$JAMSESSION_CONFIG"
  fi
  eval "JAMSESSION_PROVIDER_BIN=\${$JAMSESSION_BIN_VARIABLE:-$JAMSESSION_DEFAULT_BIN}"
  JAMSESSION_CWD="${JAMSESSION_CWD:-$PWD}"
  unset JAMSESSION_PROMPT_LITERAL
}

# Adapter scratch files live in a private mktemp directory. A predictable path
# in a shared /tmp could be pre-created or symlinked by another user.
JAMSESSION_TEMP_DIR=""

jamsession_clean_temp_dir() {
  [ -n "$JAMSESSION_TEMP_DIR" ] || return 0
  rm -rf "$JAMSESSION_TEMP_DIR"
  JAMSESSION_TEMP_DIR=""
}

jamsession_make_temp_dir() {
  jamsession_clean_temp_dir
  JAMSESSION_TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/jamsession-$JAMSESSION_PROVIDER.XXXXXX")" || \
    jamsession_die "could not create a private temporary directory"
  trap 'jamsession_clean_temp_dir' EXIT
  trap 'jamsession_clean_temp_dir; exit 130' HUP INT TERM
}

jamsession_die() {
  printf 'jamsession_%s: %s\n' "$JAMSESSION_PROVIDER" "$*" >&2
  exit 2
}

jamsession_unsupported() {
  printf 'jamsession_%s: %s is not available from this provider CLI\n' "$JAMSESSION_PROVIDER" "$1" >&2
  exit 3
}

jamsession_require_binary() {
  command -v "$JAMSESSION_PROVIDER_BIN" >/dev/null 2>&1 || \
    jamsession_die "CLI not found: $JAMSESSION_PROVIDER_BIN; run 'jamsession init' or edit jamsession.conf"
}

jamsession_read_prompt() {
  JAMSESSION_PROMPT="$1"
  if [ "$JAMSESSION_PROMPT" = "-" ] && [ "${JAMSESSION_PROMPT_LITERAL:-0}" -eq 0 ]; then
    JAMSESSION_PROMPT="$(cat)"
  fi
  [ -n "$JAMSESSION_PROMPT" ] || jamsession_die "prompt must not be empty"
}

jamsession_validate_run() {
  [ $# -eq 5 ] || jamsession_die "run needs <new|session> <model> <effort> <read|edit> <prompt>"
  JAMSESSION_SESSION="$1"
  JAMSESSION_MODEL="$2"
  JAMSESSION_EFFORT="$3"
  JAMSESSION_ACCESS="$4"
  [ -n "$JAMSESSION_SESSION" ] || jamsession_die "session must be new or a provider-native ID"
  [ -n "$JAMSESSION_MODEL" ] || jamsession_die "model must not be empty"
  [ -n "$JAMSESSION_EFFORT" ] || jamsession_die "effort must not be empty"
  case "$JAMSESSION_ACCESS" in read|edit) ;; *) jamsession_die "access must be read or edit" ;; esac
  jamsession_read_prompt "$5"
}

jamsession_uuid() {
  printf '%04x%04x-%04x-4%03x-%x%03x-%04x%04x%04x\n' \
    "$RANDOM" "$RANDOM" "$RANDOM" "$((RANDOM & 4095))" \
    "$((8 + RANDOM % 4))" "$((RANDOM & 4095))" \
    "$RANDOM" "$RANDOM" "$RANDOM"
}

jamsession_session() {
  printf 'session: %s\n' "$1" >&2
}

jamsession_hint() {
  [ "$JAMSESSION_SESSION" = new ] || return 0
  printf 'hint: %s\n' "$*" >&2
}

jamsession_positive_count() {
  case "$1" in ""|*[!0-9]*|0) jamsession_die "count must be a positive integer" ;; esac
}

jamsession_validate_message() {
  [ $# -eq 2 ] || [ $# -eq 6 ] || jamsession_die "message needs <session> <text> [--resume-with <model> <effort> <read|edit>]"
  [ -n "$1" ] || jamsession_die "session must not be empty"
  case "$1" in -*) jamsession_die "session must not begin with '-'" ;; esac
  [ "$1" != new ] || jamsession_die "message needs an existing session, not new"
  JAMSESSION_MESSAGE_SESSION="$1"
  JAMSESSION_MESSAGE_RESUME=0
  if [ $# -eq 6 ]; then
    [ "$3" = --resume-with ] || jamsession_die "expected --resume-with <model> <effort> <read|edit>"
    [ -n "$4" ] && [ -n "$5" ] || jamsession_die "model and effort must not be empty"
    case "$6" in read|edit) ;; *) jamsession_die "access must be read or edit" ;; esac
    JAMSESSION_MESSAGE_MODEL="$4"
    JAMSESSION_MESSAGE_EFFORT="$5"
    JAMSESSION_MESSAGE_ACCESS="$6"
    JAMSESSION_MESSAGE_RESUME=1
  fi
  jamsession_read_prompt "$2"
}

jamsession_native_message_settings() {
  [ "$JAMSESSION_MESSAGE_RESUME" -eq 0 ] || \
    printf 'warning: --resume-with ignored; native delivery keeps the session\047s model/effort/access\n' >&2
}

# Only adapters without native messaging call this. A native send's exit code
# never selects fallback: an error may occur after its message was accepted.
jamsession_resume_message() {
  [ "$JAMSESSION_MESSAGE_RESUME" -eq 1 ] || jamsession_unsupported message
  printf 'delivery: resume (not queued); the target must have no owning process\n' >&2
  # Bash dynamic scope marks only this internal call's already-decoded text.
  # Do not reinterpret a literal dash or strip literal trailing newlines.
  local JAMSESSION_PROMPT_LITERAL=1
  run_agent "$JAMSESSION_MESSAGE_SESSION" "$JAMSESSION_MESSAGE_MODEL" \
    "$JAMSESSION_MESSAGE_EFFORT" "$JAMSESSION_MESSAGE_ACCESS" "$JAMSESSION_PROMPT"
}

jamsession_validate_which() {
  [ $# -le 1 ] || jamsession_die "which takes an optional session ID"
  JAMSESSION_WHICH_SESSION="${1:-}"
  case "$JAMSESSION_WHICH_SESSION" in
    -*) jamsession_die "session ID must not begin with '-'" ;;
    ""|*[!a-zA-Z0-9._-]*)
      [ -z "$JAMSESSION_WHICH_SESSION" ] || jamsession_die "session ID contains unsupported characters"
      ;;
  esac
}

jamsession_find_session_file() {
  local root="$1" session="$2" basename="$3"
  [ -d "$root" ] || return 1
  find "$root" -type f -path "*/$session/$basename" -print -quit 2>/dev/null
}

# Extract one string from compact provider JSON. This intentionally implements
# only JSON string escaping, not a general JSON parser.
jamsession_json_string() {
  local json="$1" field="$2" needle rest character escape output hex index
  needle="\"$field\":\""
  case "$json" in *"$needle"*) ;; *) return 1 ;; esac
  rest="${json#*"$needle"}"
  output=""
  while [ -n "$rest" ]; do
    character="${rest%"${rest#?}"}"
    rest="${rest#?}"
    if [ "$character" = '"' ]; then
      printf '%s' "$output"
      return 0
    fi
    if [ "$character" != '\' ]; then
      output="$output$character"
      continue
    fi
    [ -n "$rest" ] || return 1
    escape="${rest%"${rest#?}"}"
    rest="${rest#?}"
    case "$escape" in
      '"'|'\'|/) output="$output$escape" ;;
      b) printf -v character '\b'; output="$output$character" ;;
      f) printf -v character '\f'; output="$output$character" ;;
      n) printf -v character '\n'; output="$output$character" ;;
      r) printf -v character '\r'; output="$output$character" ;;
      t) printf -v character '\t'; output="$output$character" ;;
      u)
        hex=""
        for index in 1 2 3 4; do
          [ -n "$rest" ] || return 1
          character="${rest%"${rest#?}"}"
          rest="${rest#?}"
          hex="$hex$character"
        done
        # Provider output normally contains UTF-8 directly. Preserve uncommon
        # escaped code points rather than guessing at surrogate-pair handling.
        output="${output}\\u${hex}"
        ;;
      *) return 1 ;;
    esac
  done
  return 1
}
