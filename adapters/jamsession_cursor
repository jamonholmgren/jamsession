#!/usr/bin/env bash

set -u

ADAPTER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_jamsession_adapter_common
source "$ADAPTER_DIR/_jamsession_adapter_common"
jamsession_adapter_setup cursor cursor-agent JAMSESSION_CURSOR_BIN

help_text() {
  cat <<'EOF'
jamsession_cursor

Run:    jamsession_cursor run <new|session> <model> <effort> <read|edit> <prompt>
Other:  jamsession_cursor <list|models|usage|status|doctor|help>

Cursor read mode uses ask mode. Edit mode uses --force and --trust so the
non-interactive session cannot stall at an approval prompt. Explicit effort is
matched against Cursor's live model catalog, so `grok-4.6 high` can resolve to
an exact identifier such as `cursor-grok-4.6-high`. Exact identifiers still
work. It is an error to request effort with the default model or with a model
that already carries overrides.
EOF
}

model_effort_suffix() {
  local model="${1%-fast}" suffix=""
  case "$model" in
    *-extra-high) printf '%s\n' xhigh; return ;;
  esac
  suffix="${model##*-}"
  case "$suffix" in
    none|minimal|low|medium|high|xhigh|max|ultra) printf '%s\n' "$suffix" ;;
  esac
}

cursor_model_base() {
  local model="${1%-fast}" effort
  effort="$(model_effort_suffix "$model")"
  [ -z "$effort" ] || {
    case "$model" in
      *-extra-high) model="${model%-extra-high}" ;;
      *) model="${model%-$effort}" ;;
    esac
  }
  printf '%s\n' "$model"
}

normalize_model_name() {
  printf '%s' "$1" | tr '[:upper:]._' '[:lower:]--'
}

resolve_cursor_model() {
  local requested="$1" effort="$2" output id base normalized_requested normalized_base
  local candidate="" matches="" base_matches="" match_count=0
  output="$($JAMSESSION_PROVIDER_BIN --list-models)" || \
    jamsession_die "could not list Cursor models while resolving '$requested'"
  normalized_requested="$(normalize_model_name "$requested")"

  while IFS= read -r id; do
    case "$id" in
      ""|'Available models'|'Tip:'*) continue ;;
      *' - '*) id="${id%% - *}" ;;
      *) continue ;;
    esac
    [ "$id" != "$requested" ] || { printf '%s\n' "$id"; return; }
    case "$id" in *-fast) continue ;; esac
    base="$(cursor_model_base "$id")"
    normalized_base="$(normalize_model_name "$base")"
    case "$normalized_base" in
      "$normalized_requested"|*"-$normalized_requested")
        base_matches="${base_matches}${base_matches:+, }$id"
        if [ "$effort" = default ] || [ "$(model_effort_suffix "$id")" = "$effort" ]; then
          candidate="$id"
          matches="${matches}${matches:+, }$id"
          match_count=$((match_count + 1))
        fi
        ;;
    esac
  done <<EOF
$output
EOF

  if [ "$match_count" -eq 1 ]; then
    printf '%s\n' "$candidate"
    return
  fi
  if [ "$match_count" -gt 1 ]; then
    jamsession_die "model shorthand '$requested' is ambiguous; use one of: $matches"
  fi
  if [ -n "$base_matches" ]; then
    jamsession_die "model shorthand '$requested' has no '$effort' variant; available: $base_matches"
  fi
  printf '%s\n' "$requested"
}

run_agent() {
  jamsession_validate_run "$@"
  jamsession_require_binary

  local session_id model model_effort status raw result
  local -a args model_args

  # Resolve the model before creating a chat so a rejected run leaves no
  # orphaned Cursor session behind.
  model_args=()
  if [ "$JAMSESSION_MODEL" = default ]; then
    [ "$JAMSESSION_EFFORT" = default ] || \
      jamsession_die "Cursor encodes effort in the model, so explicit effort needs an explicit model"
  else
    model="$(resolve_cursor_model "$JAMSESSION_MODEL" "$JAMSESSION_EFFORT")" || exit $?
    case "$JAMSESSION_EFFORT" in
      default) ;;
      none) jamsession_die "Cursor has no none effort; pass default or a supported effort" ;;
      *)
        case "$model" in
          *'['*) jamsession_die "model '$model' already contains overrides; pass default effort or remove them" ;;
        esac
        model_effort="$(model_effort_suffix "$model")"
        if [ -n "$model_effort" ] && [ "$model_effort" != "$JAMSESSION_EFFORT" ]; then
          jamsession_die "model '$model' already encodes effort '$model_effort'; pass matching or default effort"
        fi
        [ -n "$model_effort" ] || model="$model[effort=$JAMSESSION_EFFORT]"
        ;;
    esac
    model_args=(--model "$model")
  fi

  if [ "$JAMSESSION_SESSION" = new ]; then
    session_id="$("$JAMSESSION_PROVIDER_BIN" create-chat)" || jamsession_die "create-chat failed"
    [ -n "$session_id" ] || jamsession_die "create-chat returned no session identifier"
  else
    session_id="$JAMSESSION_SESSION"
  fi

  args=(-p --output-format json --trust --workspace "$JAMSESSION_CWD" --resume "$session_id")
  [ "${#model_args[@]}" -eq 0 ] || args+=("${model_args[@]}")

  if [ "$JAMSESSION_ACCESS" = read ]; then
    args+=(--mode ask)
    jamsession_hint "Cursor ask mode blocks edits while allowing unattended inspection."
  else
    args+=(--force)
    jamsession_hint "Cursor may run commands and edit the trusted workspace without asking."
  fi
  args+=("$JAMSESSION_PROMPT")

  jamsession_session "$session_id"
  status=0
  # Cursor is asked for JSON and parsed here on purpose. Live testing showed its
  # plain output drops the final response after the agent uses tools, so the
  # cheaper-looking plain format silently returns nothing. Do not "simplify".
  raw="$("$JAMSESSION_PROVIDER_BIN" "${args[@]}" </dev/null)" || status=$?
  if result="$(jamsession_json_string "$raw" result)"; then
    printf '%s\n' "$result"
  elif [ -n "$raw" ]; then
    printf '%s\n' "$raw"
    [ "$status" -ne 0 ] || status=2
    printf 'jamsession_cursor: could not extract the final response from provider JSON\n' >&2
  fi
  exit "$status"
}

case "${1:-help}" in
  run) shift; run_agent "$@" ;;
  models) jamsession_require_binary; "$JAMSESSION_PROVIDER_BIN" --list-models ;;
  list|usage|status) jamsession_unsupported "$1" ;;
  doctor) jamsession_require_binary; "$JAMSESSION_PROVIDER_BIN" status ;;
  help|-h|--help) help_text ;;
  *) jamsession_die "unknown command '$1'" ;;
esac
