#!/usr/bin/env bash

set -u

ADAPTER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_jamsession_adapter_common
source "$ADAPTER_DIR/_jamsession_adapter_common"
jamsession_adapter_setup muse muse JAMSESSION_MUSE_BIN

help_text() {
  cat <<'EOF'
jamsession_muse

Run:    jamsession_muse run <new|session> <model> <effort> <read|edit> <prompt>
Other:  jamsession_muse <list|which|models|message|usage|status|doctor|help>

Message: jamsession_muse message <session> <text> sends asynchronously.
Optional --resume-with settings are validated but unused by native delivery.
A closed ingress errors; it never triggers a resume. See `jamsession help message`.

Muse uses headless `exec` and resumes with its native session UUID. Read mode
disables both shell execution and workspace writes. Edit mode allows unattended
workspace changes within Muse's normal sandbox. Muse does not expose native
headless session or model listing commands; list and models read its local
session logs and cached model catalog.
Usage reads last-observed subscription windows through `muse serve` and
`usage/read`, without a model turn. Missing or expired observations are
unavailable, not zero usage. It needs system Python 3; observation times are
included so retained data is not presented as a live balance.
EOF
}

list_sessions() {
  [ $# -le 1 ] || jamsession_die "list takes an optional count"
  local count="${1:-5}" root="$HOME/.local/share/muse/sessions" path
  local -a logs=()
  jamsession_positive_count "$count"
  [ -d "$root" ] || jamsession_unsupported list
  while IFS= read -r -d '' path; do logs+=("$path"); done \
    < <(find "$root" -type f -name session.jsonl ! -path '*/subagent/*' -print0)
  [ "${#logs[@]}" -gt 0 ] || jamsession_unsupported list
  ls -t "${logs[@]}" | head -n "$count" | while IFS= read -r path; do
    path="${path%/session.jsonl}"
    printf '%s\n' "${path##*/}"
  done
  printf 'note: recent local Muse sessions across workspaces\n' >&2
}

list_models() {
  local root="$HOME/.local/share/muse/model-catalog" models
  local -a catalogs
  catalogs=("$root"/*.json)
  [ -f "${catalogs[0]}" ] || jamsession_unsupported models
  models="$(awk -F '"' '
    {
      for (i = 2; i <= NF - 2; i++) {
        if ($i == "model_id") model = $(i + 2)
        if ($i == "visibility") {
          if ($(i + 2) == "visible" && model != "") print model
          model = ""
        }
      }
    }
  ' "${catalogs[@]}" | sort -u)"
  [ -n "$models" ] || jamsession_unsupported models
  printf '%s\n' "$models"
  printf 'note: cached local Muse model catalog; Muse may refresh it on launch\n' >&2
}

which_transcript() {
  jamsession_validate_which "$@"
  local root="$HOME/.local/share/muse/sessions" path
  path="$root"
  if [ -n "$JAMSESSION_WHICH_SESSION" ]; then
    path="$(jamsession_find_session_file "$root" "$JAMSESSION_WHICH_SESSION" session.jsonl)"
    [ -n "$path" ] || jamsession_die "session '$JAMSESSION_WHICH_SESSION' was not found under $root"
    printf 'path: %s\nformat: JSONL\nread: less %q\n' "$path" "$path"
    printf 'export: muse export --session %q --redacted --out /tmp/muse-session.json\n' "$JAMSESSION_WHICH_SESSION"
  else
    printf 'path: %s\nformat: per-session JSONL directories\nread: muse export --last --redacted\n' "$path"
  fi
}

# Each model call's input already includes cached tokens.
session_size() {
  local path line input output
  path="$(jamsession_find_session_file "$HOME/.local/share/muse/sessions" "$1" session.jsonl)"
  line="$([ -z "$path" ] || grep -F '"kind":"model_completed"' "$path" | tail -n 1)"
  [ -n "$line" ] || { jamsession_session_size ""; return; }
  line="${line##*\"usage\":\{}"
  input="$(jamsession_json_number "$line" input_tokens)"
  output="$(jamsession_json_number "$line" output_tokens)"
  jamsession_session_size "$((${input:-0} + ${output:-0}))"
}

run_agent() {
  jamsession_validate_run "$@"
  jamsession_require_binary

  local events errors status session_id line final_text
  local -a args
  jamsession_make_temp_dir
  events="$JAMSESSION_TEMP_DIR/events"
  errors="$JAMSESSION_TEMP_DIR/errors"
  args=(exec --json --trust-workspace --disable-approval)
  [ "$JAMSESSION_MODEL" = default ] || args+=(--model "$JAMSESSION_MODEL")
  [ "$JAMSESSION_EFFORT" = default ] || args+=(--reasoning-effort "$JAMSESSION_EFFORT")
  if [ "$JAMSESSION_ACCESS" = read ]; then
    args+=(--disable-shell --disable-write)
    jamsession_hint "Muse shell and workspace writes are disabled."
  else
    jamsession_hint "Muse may edit the current workspace without asking for approval."
  fi
  if [ "$JAMSESSION_SESSION" != new ]; then
    args+=(--session-id "$JAMSESSION_SESSION")
  fi
  args+=("$JAMSESSION_PROMPT")

  status=0
  (cd "$JAMSESSION_CWD" && "$JAMSESSION_PROVIDER_BIN" "${args[@]}" </dev/null >"$events" 2>"$errors") || status=$?
  [ ! -s "$errors" ] || cat "$errors" >&2

  session_id=""
  if [ "$JAMSESSION_SESSION" = new ]; then
    session_id="$(sed -n 's/.*"stream":{"kind":"session","id":"\([^"]*\)".*/\1/p' "$events" | head -n 1)"
  else
    session_id="$JAMSESSION_SESSION"
  fi
  [ -z "$session_id" ] || jamsession_session "$session_id"

  final_text=""
  while IFS= read -r line; do
    case "$line" in
      *'"payload_type":"run.terminal.completed"'*)
        final_text="$(jamsession_json_string "$line" text || true)"
        ;;
    esac
  done <"$events"
  [ -z "$final_text" ] || printf '%s\n' "$final_text"
  if [ "$status" -eq 0 ] && [ -z "$session_id" ]; then
    jamsession_die "Muse returned no session identifier"
  fi
  if [ "$status" -ne 0 ] && [ -s "$events" ] && [ -z "$final_text" ]; then
    tail -n 1 "$events" >&2
  fi
  [ -z "$session_id" ] || session_size "$session_id"
  exit "$status"
}

case "${1:-help}" in
  message)
    shift; jamsession_validate_message "$@"; jamsession_require_binary
    jamsession_native_message_settings
    (cd "$JAMSESSION_CWD" && printf '%s' "$JAMSESSION_PROMPT" | \
      "$JAMSESSION_PROVIDER_BIN" session-message send --target "$JAMSESSION_MESSAGE_SESSION" --json)
    ;;
  run) shift; run_agent "$@" ;;
  which) shift; which_transcript "$@" ;;
  list) shift; list_sessions "$@" ;;
  models) shift; list_models "$@" ;;
  usage) shift; jamsession_adapter_usage "$@" ;;
  status) jamsession_unsupported "$1" ;;
  doctor)
    jamsession_require_binary
    "$JAMSESSION_PROVIDER_BIN" --version
    printf 'authentication: not checked (Muse exposes no noninteractive status)\n'
    ;;
  help|-h|--help) help_text ;;
  *) jamsession_die "unknown command '$1'" ;;
esac
